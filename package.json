{
  "name": "strujam8",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/StruJam8/",
    "preview": "vite preview",
    "demo:capture": "node scripts/capture-demo.mjs",
    "verify:techniques": "node scripts/verify-techniques.mjs",
    "verify:highlighting": "node scripts/verify-highlighting.mjs",
    "test": "vitest run",
    "check": "npm test && npm run build",
    "check:pages": "npm test && npm run build:pages",
    "test:e2e": "playwright test",
    "test:e2e:pages": "npm run build:pages && node scripts/prepare-pages-preview.mjs && playwright test --config=playwright.pages.config.ts"
  },
  "dependencies": {
    "@strudel/web": "^1.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.4",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
